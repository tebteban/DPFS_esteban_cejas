<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Mi perfil - Zona 6</title>
</head>
<body class="flex flex-col min-h-screen">
    <%- include('../partials/header') %>

    <main class="flex-grow max-w-container w-full mx-auto px-4 md:px-8 py-10 md:py-14">
        <h1 class="display-xl mb-8">Hola, <%= user.firstName %></h1>

        <div class="grid md:grid-cols-3 gap-6 items-start">
            <div class="card-soft text-center">
                <img class="h-32 w-32 mx-auto rounded-full object-cover mb-4"
                     src="<%= avatarImg(user.image) %>" alt="Foto de <%= user.firstName %>"
                     onerror="this.onerror=null;this.src='/img/users/default.svg';">
                <p class="display-sm"><%= user.firstName %> <%= user.lastName %></p>
                <span class="chip chip-active mt-3"><%= user.role === 'admin' ? 'Administrador' : 'Cliente' %></span>
            </div>

            <div class="card-soft md:col-span-2">
                <h2 class="display-sm mb-4">Información de la cuenta</h2>
                <dl class="divide-y divide-pressed">
                    <div class="py-3 flex justify-between gap-4"><dt class="text-body">Nombre</dt><dd class="font-medium text-right"><%= user.firstName %> <%= user.lastName %></dd></div>
                    <div class="py-3 flex justify-between gap-4"><dt class="text-body">Email</dt><dd class="font-medium text-right break-all"><%= user.email %></dd></div>
                    <div class="py-3 flex justify-between gap-4"><dt class="text-body">ID de usuario</dt><dd class="font-medium text-right"><%= user.id %></dd></div>
                </dl>
                <div class="flex flex-wrap gap-3 mt-6">
                    <% if (user.role === 'admin') { %><a href="/admin" class="btn btn-primary">Ir al panel</a><% } %>
                    <a href="/users/profile/edit" class="btn btn-secondary">Editar perfil</a>
                    <a href="/users/logout" class="btn btn-secondary">Cerrar sesión</a>
                </div>
            </div>
        </div>

        <section class="mt-10">
            <h2 class="display-md mb-4">Mis compras</h2>
            <% if (orders.length > 0) { %>
                <div class="space-y-4">
                    <% orders.forEach(order => { %>
                        <div class="card-soft !p-5 reveal">
                            <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                                <div>
                                    <p class="font-medium">Pedido #<%= order.id %></p>
                                    <p class="text-sm text-body"><%= order.createdAt.toLocaleDateString('es-AR', { dateStyle: 'long' }) %></p>
                                </div>
                                <span class="chip !py-1 <%= order.status === 'approved' ? 'chip-active' : '!bg-white' %>"><%= orderStatus(order.status) %></span>
                            </div>
                            <% order.items.forEach(item => { %>
                                <div class="flex justify-between text-sm py-1"><span class="text-body"><%= item.quantity %>× <%= item.name %><%= item.size ? ' · Talle ' + item.size : '' %></span><span>$<%= (item.unit_price * item.quantity).toFixed(2) %></span></div>
                            <% }) %>
                            <div class="flex justify-between border-t border-pressed mt-2 pt-2 font-medium"><span>Total</span><span>$<%= Number(order.total).toFixed(2) %></span></div>
                        </div>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="card-soft text-center">
                    <p class="text-body mb-4">Todavía no hiciste ninguna compra.</p>
                    <a href="/productos" class="btn btn-primary">Ir al catálogo</a>
                </div>
            <% } %>
        </section>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
