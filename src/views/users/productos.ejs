<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title><%= pageTitle %> - Zona 6</title>
</head>
<body class="flex flex-col min-h-screen">
    <%- include('../partials/header') %>

    <main class="flex-grow max-w-container w-full mx-auto px-4 md:px-8 py-10 md:py-14">
        <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8">
            <div>
                <p class="eyebrow mb-2">Equipamiento técnico</p>
                <h1 class="display-xl"><%= pageTitle %></h1>
            </div>

            <form action="/productos/buscar-producto" method="GET" class="flex gap-2 w-full lg:w-auto lg:min-w-[420px]" role="search">
                <label for="searchInput" class="sr-only">Buscar productos</label>
                <input type="search" id="searchInput" name="q" value="<%= locals.searchTerm || '' %>"
                       placeholder="Buscar equipamiento..." class="input !rounded-full !py-2.5" autocomplete="off"/>
                <button type="submit" class="btn btn-primary" aria-label="Buscar">
                    <span class="material-icons-outlined">search</span>
                </button>
            </form>
        </div>

        <form action="/productos" method="GET" class="flex flex-wrap items-center gap-3 mb-10">
            <a href="/productos<%= currentOrder ? '?orden=' + currentOrder : '' %>" class="chip <%= !currentCategory ? 'chip-active' : '' %>">Todas</a>
            <% categories.forEach(cat => { %>
                <a href="/productos?categoria=<%= cat.id %><%= currentOrder ? '&orden=' + currentOrder : '' %>"
                   class="chip <%= currentCategory == cat.id ? 'chip-active' : '' %>"><%= cat.name %></a>
            <% }) %>

            <% if (currentCategory) { %><input type="hidden" name="categoria" value="<%= currentCategory %>"><% } %>
            <label for="orden" class="sr-only">Ordenar</label>
            <select id="orden" name="orden" onchange="this.form.submit()" class="chip !pr-8 border-0 cursor-pointer sm:ml-auto">
                <option value="">Ordenar por</option>
                <option value="precio_asc" <%= currentOrder === 'precio_asc' ? 'selected' : '' %>>Menor precio</option>
                <option value="precio_desc" <%= currentOrder === 'precio_desc' ? 'selected' : '' %>>Mayor precio</option>
            </select>
            <noscript><button type="submit" class="btn btn-subtle">Aplicar</button></noscript>
        </form>

        <% if (products && products.length > 0) { %>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <% products.forEach(product => { %>
                    <article class="flex flex-col group">
                        <a href="/productos/<%= product.id %>" class="block">
                            <div class="product-media mb-4 transition-colors group-hover:bg-canvas-soft">
                                <img src="<%= productImg(product.image) %>" alt="<%= product.name %>" loading="lazy"
                                     onerror="this.onerror=null;this.src='/img/products/default.svg'"/>
                            </div>
                            <% if (product.category) { %><p class="eyebrow mb-1"><%= product.category.name %></p><% } %>
                            <h2 class="font-medium line-clamp-2"><%= product.name %></h2>
                            <p class="text-sm text-body line-clamp-2 mt-1"><%= product.description %></p>
                        </a>
                        <div class="flex items-center justify-between gap-3 mt-auto pt-4">
                            <p class="display-sm">$<%= Number(product.price).toFixed(2) %></p>
                            <% if (product.stock > 0) { %>
                                <button class="btn btn-subtle add-to-cart-btn"
                                        data-product-id="<%= product.id %>"
                                        data-product-name="<%= product.name %>"
                                        data-product-price="<%= product.price %>"
                                        data-product-image="<%= productImg(product.image) %>">
                                    Agregar
                                </button>
                            <% } else { %>
                                <button class="btn" disabled>Agotado</button>
                            <% } %>
                        </div>
                    </article>
                <% }); %>
            </div>
        <% } else { %>
            <div class="card-soft md:!p-8 text-center">
                <p class="display-sm mb-2">No encontramos productos</p>
                <p class="text-body mb-6">Probá con otra búsqueda o mirá todo el catálogo.</p>
                <a href="/productos" class="btn btn-primary">Ver catálogo</a>
            </div>
        <% } %>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
