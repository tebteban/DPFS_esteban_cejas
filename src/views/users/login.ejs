<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/head') %>
    <title>Ingresar - Zona 6</title>
</head>
<body class="flex flex-col min-h-screen">
    <%- include('../partials/header') %>

    <main class="flex-grow flex items-center justify-center px-4 py-12">
        <div class="card-soft md:!p-8 max-w-md w-full">
            <h1 class="display-lg mb-2">Ingresar</h1>
            <p class="text-body mb-6">Accedé a tu cuenta de Zona 6.</p>

            <%- include('../partials/errors') %>
            <% if (locals.query && query.registrationSuccess) { %>
                <div class="alert mb-6" role="status">
                    <span class="material-icons-outlined">check_circle</span>
                    <div><strong class="font-medium">¡Registro exitoso!</strong> Ya podés iniciar sesión.</div>
                </div>
            <% } %>

            <form class="space-y-5" action="/users/login" method="POST">
                <div>
                    <label class="label" for="email">Email</label>
                    <input class="input" id="email" type="email" name="email" placeholder="tu@email.com"
                           value="<%= (locals.oldData && oldData.email) || '' %>" autocomplete="email" required/>
                </div>
                <div>
                    <label class="label" for="password">Contraseña</label>
                    <input class="input" id="password" type="password" name="password" placeholder="Tu contraseña"
                           autocomplete="current-password" required/>
                </div>
                <label class="flex items-center gap-2 text-sm cursor-pointer">
                    <input id="remember-me" name="remember" type="checkbox" class="h-5 w-5 accent-black cursor-pointer"/>
                    Recordarme
                </label>
                <button class="btn btn-primary btn-lg btn-block" type="submit">Ingresar</button>
            </form>

            <p class="text-sm text-body text-center mt-6">
                ¿No tenés cuenta? <a href="/users/register" class="text-ink font-medium underline">Registrate</a>
            </p>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
