    <div class="max-w-container mx-auto px-4 md:px-8 py-12 grid gap-10 md:grid-cols-3">
        <div>
            <img src="/img/logo.png" alt="Zona 6" class="h-12 w-auto rounded-md mb-4">
            <p class="display-sm">El juego empieza abajo.</p>
            <p class="text-sm text-mute mt-2">Indumentaria técnica de vóley. Diseño y producción argentina.</p>
        </div>
        <div>
            <p class="font-medium mb-4">Tienda</p>
            <ul class="space-y-3 text-sm">
                <li><a class="footer-link" href="/productos">Catálogo</a></li>
                <li><a class="footer-link" href="/cart">Tu pedido</a></li>
                <li><a class="footer-link" href="/users/profile">Mi cuenta</a></li>
            </ul>
        </div>
        <div>
            <p class="font-medium mb-4">Seguinos</p>
            <ul class="space-y-3 text-sm">
                <li><a class="footer-link" href="#" target="_blank" rel="noopener noreferrer">Instagram · zona6.voley</a></li>
                <li><a class="footer-link" href="#" target="_blank" rel="noopener noreferrer">Facebook · zona6.voley</a></li>
            </ul>
        </div>
    </div>
    <div class="max-w-container mx-auto px-4 md:px-8 pb-8">
        <p class="text-xs text-mute">© <%= new Date().getFullYear() %> Zona 6. Todos los derechos reservados.</p>
    </div>
