<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.min.css">
<script src="https://cdn.jsdelivr.net/npm/toastify-js@1.12.0/src/toastify.js"></script>

<!-- Mini carrito lateral -->
<div id="offCanvasCart" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
    <div id="cartOverlay" class="absolute inset-0 bg-black/40"></div>

    <div id="cartSidebar" class="absolute top-0 right-0 h-full w-full max-w-sm bg-white transform translate-x-full transition-transform duration-300 flex flex-col" style="box-shadow: var(--shadow-2)">
        <div class="flex items-center justify-between p-6">
            <h2 id="cartTitle" class="display-md">Tu bolso</h2>
            <button id="closeCartBtn" class="icon-btn" aria-label="Cerrar carrito">
                <span class="material-icons-outlined">close</span>
            </button>
        </div>

        <div id="cartItemsContainer" class="flex-grow overflow-y-auto px-6 space-y-4"></div>

        <div class="p-6 space-y-4">
            <div class="flex justify-between items-center">
                <span class="text-body">Total</span>
                <span id="cartTotalDisplay" class="display-md">$0.00</span>
            </div>
            <a href="/cart" class="btn btn-subtle btn-block">Ver pedido</a>
            <button id="checkoutBtn" class="btn btn-primary btn-block">Pedir por WhatsApp</button>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cartButton = document.getElementById('cartButton');
        const offCanvasCart = document.getElementById('offCanvasCart');
        const cartOverlay = document.getElementById('cartOverlay');
        const cartSidebar = document.getElementById('cartSidebar');
        const closeCartBtn = document.getElementById('closeCartBtn');
        const cartItemsContainer = document.getElementById('cartItemsContainer');
        const cartTotalDisplay = document.getElementById('cartTotalDisplay');
        const cartItemCount = document.getElementById('cartItemCount');
        const checkoutBtn = document.getElementById('checkoutBtn');

        const formatMoney = (amount) => Number(amount).toFixed(2);
        const escapeHtml = (s) => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

        const renderCart = () => {
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            cartItemsContainer.innerHTML = '';
            let total = 0;
            let count = 0;

            if (cart.length === 0) {
                cartItemsContainer.innerHTML = '<div class="card-soft text-center text-body">Tu bolso está vacío.</div>';
            } else {
                cart.forEach((item, index) => {
                    total += item.price * item.quantity;
                    count += item.quantity;

                    cartItemsContainer.insertAdjacentHTML('beforeend', `
                        <div class="flex items-center gap-4 pb-4 border-b border-canvas-soft">
                            <div class="h-16 w-16 shrink-0 rounded-xl bg-canvas-softer p-1">
                                <img src="${escapeHtml(item.image)}" alt="" class="h-full w-full object-contain mix-blend-multiply">
                            </div>
                            <div class="flex-grow min-w-0">
                                <h3 class="text-sm font-medium line-clamp-2">${escapeHtml(item.name)}</h3>
                                <p class="text-sm text-body mt-1">$${formatMoney(item.price)}</p>
                                <div class="flex items-center mt-2 gap-2">
                                    <button class="icon-btn !w-8 !h-8 update-qty" data-index="${index}" data-action="minus" aria-label="Restar uno">−</button>
                                    <span class="text-sm font-medium w-6 text-center">${item.quantity}</span>
                                    <button class="icon-btn !w-8 !h-8 update-qty" data-index="${index}" data-action="plus" aria-label="Sumar uno">+</button>
                                </div>
                            </div>
                            <button class="icon-btn remove-item" data-index="${index}" aria-label="Quitar producto">
                                <span class="material-icons-outlined text-xl">delete</span>
                            </button>
                        </div>
                    `);
                });
            }

            cartTotalDisplay.textContent = `$${formatMoney(total)}`;
            cartItemCount.textContent = count;
            cartItemCount.classList.toggle('hidden', count === 0);
        };

        const openCart = () => {
            renderCart();
            offCanvasCart.classList.remove('hidden');
            setTimeout(() => cartSidebar.classList.remove('translate-x-full'), 10);
        };

        const closeCart = () => {
            cartSidebar.classList.add('translate-x-full');
            setTimeout(() => offCanvasCart.classList.add('hidden'), 300);
        };

        cartButton.addEventListener('click', openCart);
        closeCartBtn.addEventListener('click', closeCart);
        cartOverlay.addEventListener('click', closeCart);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCart(); });

        cartItemsContainer.addEventListener('click', (e) => {
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            const qtyBtn = e.target.closest('.update-qty');
            const removeBtn = e.target.closest('.remove-item');

            if (qtyBtn) {
                const index = qtyBtn.dataset.index;
                if (qtyBtn.dataset.action === 'plus') cart[index].quantity++;
                else if (cart[index].quantity > 1) cart[index].quantity--;
            } else if (removeBtn) {
                cart.splice(removeBtn.dataset.index, 1);
            } else return;

            localStorage.setItem('cart', JSON.stringify(cart));
            renderCart();
        });

        checkoutBtn.addEventListener('click', () => {
            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            if (cart.length === 0) return;

            let total = 0;
            let message = 'Hola! Quiero hacer este pedido de Zona 6:\n\n';
            cart.forEach(item => {
                const sub = item.price * item.quantity;
                total += sub;
                message += `- ${item.quantity}x ${item.name} ($${formatMoney(item.price)}) = $${formatMoney(sub)}\n`;
            });
            message += `\n*TOTAL: $${formatMoney(total)}*`;

            const phoneNumber = '5493854996011';
            window.open(`https://wa.me/${phoneNumber}?text=${encodeURIComponent(message)}`, '_blank');
        });

        // Agregar al carrito desde cualquier vista (botones .add-to-cart-btn)
        document.body.addEventListener('click', (e) => {
            const btn = e.target.closest('.add-to-cart-btn');
            if (!btn) return;

            const { productId, productName, productImage } = btn.dataset;
            const productPrice = parseFloat(btn.dataset.productPrice);

            const cart = JSON.parse(localStorage.getItem('cart')) || [];
            const existing = cart.findIndex(item => item.id === productId);
            if (existing > -1) cart[existing].quantity += 1;
            else cart.push({ id: productId, name: productName, price: productPrice, image: productImage, quantity: 1 });
            localStorage.setItem('cart', JSON.stringify(cart));

            renderCart();

            Toastify({
                text: `Agregado: ${productName}`,
                duration: 3000,
                gravity: 'bottom',
                position: 'right',
                stopOnFocus: true,
                style: {
                    background: '#000000',
                    color: '#ffffff',
                    fontFamily: 'Inter, system-ui, sans-serif',
                    fontWeight: '500',
                    borderRadius: '16px',
                    padding: '12px 16px',
                    boxShadow: 'rgba(0, 0, 0, 0.16) 0px 4px 16px 0px'
                }
            }).showToast();
        });

        renderCart();
    });
</script>
