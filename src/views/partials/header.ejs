<header class="bg-white sticky top-0 z-50 border-b border-canvas-soft">
    <div class="max-w-container mx-auto px-4 md:px-8">
        <div class="flex justify-between items-center h-16 gap-4">
            <div class="flex items-center gap-8">
                <a href="/" class="shrink-0" aria-label="Zona 6 - Inicio">
                    <img src="/img/logo.png" alt="Zona 6" class="h-9 w-auto rounded-md">
                </a>
                <nav class="hidden md:flex items-center gap-6 font-medium">
                    <a class="hover:text-body transition-colors" href="/">Inicio</a>
                    <a class="hover:text-body transition-colors" href="/productos">Catálogo</a>
                    <% if (locals.user && user.role === 'admin') { %>
                        <a class="hover:text-body transition-colors" href="/admin">Panel</a>
                    <% } %>
                </nav>
            </div>

            <div class="flex items-center gap-3">
                <div class="hidden md:flex items-center gap-3">
                    <% if (locals.user) { %>
                        <a href="/users/profile" class="btn btn-subtle !px-2 !pr-4">
                            <img src="<%= avatarImg(user.image) %>" alt="" class="h-8 w-8 rounded-full object-cover"
                                 onerror="this.onerror=null;this.src='/img/users/default.svg';">
                            <span class="truncate max-w-[120px]"><%= user.firstName %></span>
                        </a>
                        <a class="btn btn-secondary" href="/users/logout">Salir</a>
                    <% } else { %>
                        <a class="btn btn-subtle" href="/users/login">Ingresar</a>
                        <a class="btn btn-primary" href="/users/register">Registrarse</a>
                    <% } %>
                </div>

                <button id="cartButton" class="icon-btn" aria-label="Abrir carrito">
                    <span class="material-icons-outlined">shopping_bag</span>
                    <span id="cartItemCount" class="absolute -top-1 -right-1 bg-ink text-white text-xs font-medium rounded-full h-5 min-w-[20px] px-1 flex items-center justify-center hidden">0</span>
                </button>

                <button id="menuButton" class="icon-btn md:hidden" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobileMenu">
                    <span class="material-icons-outlined">menu</span>
                </button>
            </div>
        </div>
    </div>

    <nav id="mobileMenu" class="md:hidden hidden border-t border-canvas-soft px-4 py-4 flex-col gap-2 bg-white">
        <a class="py-3 font-medium" href="/">Inicio</a>
        <a class="py-3 font-medium" href="/productos">Catálogo</a>
        <% if (locals.user) { %>
            <% if (user.role === 'admin') { %><a class="py-3 font-medium" href="/admin">Panel</a><% } %>
            <a class="py-3 font-medium" href="/users/profile">Mi perfil</a>
            <a class="btn btn-secondary mt-2" href="/users/logout">Salir</a>
        <% } else { %>
            <a class="btn btn-subtle mt-2" href="/users/login">Ingresar</a>
            <a class="btn btn-primary" href="/users/register">Registrarse</a>
        <% } %>
    </nav>
</header>
<script>
    document.getElementById('menuButton').addEventListener('click', (e) => {
        const menu = document.getElementById('mobileMenu');
        const open = menu.classList.toggle('hidden') === false;
        menu.classList.toggle('flex', open);
        e.currentTarget.setAttribute('aria-expanded', open);
    });
</script>
